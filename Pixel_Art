                  Entree_Couleur13, Entree_Couleur14, Entree_Couleur15, Entree_Couleur16]:
        entry.delete(0, 'end')  # Efface le contenu des entrée

    canvas_pixel_art.delete("all")  # Efface tout dans le canevas
    afficher_tableau_initial()  # Réaffiche la table initiale
    # Mettez à jour le texte du compteur d'essai
    canvas_parametre.itemconfig(CompteurDeEssai, text=str(compteur_essai))

# Ce fonction réaffiche le tableau sans les couleur en appuient le bouton rénover
def afficher_tableau_initial():
    # table oiseau et table drapeau_comores
    if defi_actuel == 1:
        for ligne in range(20):
            for colonne in range(21):
                x = (colonne + 0.8) * Largeur
                y = (ligne + 1) * hauteur
                pixel = oiseau[ligne][colonne]
                canvas_pixel_art.create_text(x, y, text=str(pixel))
                canvas_pixel_art.create_rectangle(x-Largeur//2,y-hauteur//2,x+Largeur//2,y+hauteur//2)
    elif defi_actuel == 2:
        for ligne in range(20):
            for colonne in range (21):
                x = (colonne + 0.8)* Largeur
                y = (ligne + 1)* hauteur
                pixel = drapeau_comores[ligne][colonne]
                canvas_pixel_art.create_text(x,y,text = str(pixel))
                canvas_pixel_art.create_rectangle(x-Largeur//2,y-hauteur//2,x+Largeur//2,y+hauteur//2)
    else:
        # table tintin
        for ligne in range(32):
            for colonne in range(28):
                x = (colonne + 1) * Largeur_tintin
                y = (ligne + 1) * hauteur_tintin
