# Cette fonction a pour rôle de réinitialiser la partie
def renitialiser():
    global compteur_essai
    compteur_essai = compteur_essai * 0
    for entry in [Entree_Couleur1, Entree_Couleur2, Entree_Couleur3, Entree_Couleur4,
                  Entree_Couleur5, Entree_Couleur6, Entree_Couleur7, Entree_Couleur8,
