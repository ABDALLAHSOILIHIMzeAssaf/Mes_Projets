# Définition d'une classe Pile
class Pile:
    def __init__(self,v=[]):
        self.valeurs=v
        self.taille=len(self.valeurs)

    def empile(self,n):
        self.valeurs.append(n)
        self.taille=len(self.valeurs)

    def depile(self):
        n=self.valeurs
        if n == None:
            print("La pile est vide")
        else:
            n=self.valeurs.pop()
            self.taille=len(self.valeurs)
        return n

    def pile_vide(self):
        return self.valeurs == None



    def sommet(self):
       return self.valeurs[-1]

