def dessiner_pion(x, y, symbole, couleur):
    up()
    goto(x + 10, y - 60 + 5)
    down()
    color(couleur)
    write(symbole, font=("ArialUnicode MS", 36, "normal"))

for ligne in range(10):
    for colonne in range(10):
        if (ligne + colonne) % 2 == 0:
            x_case = x + colonne * 60
            y_case = y - ligne * 60

            if ligne < 4:
                dessiner_pion(x_case, y_case, "\u26C0", "black")
            elif ligne > 5:
                dessiner_pion(x_case, y_case, "\u26C2", "red")

